{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": ".vite/build/ingest",
    "rootDir": "src/database/worker",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "ignoreDeprecations":"6.0"
  },
  "include": [
    "src/database/worker/**/*.ts"
  ]
}